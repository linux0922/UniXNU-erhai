+// Experimental RAM-only loader. DBRDISK1 metadata is bounded before any write.
+STATIC EFI_STATUS RestoreReadExact(EFI_FILE_PROTOCOL *File, VOID *Data, UINTN Bytes) {
+  UINTN Actual;
+  EFI_STATUS Status;
+  while(Bytes) {
+    Actual=MIN(Bytes,SIZE_1MB);
+    Status=File->Read(File,&Actual,Data);
+    if(EFI_ERROR(Status))return Status;
+    if(!Actual || Actual>Bytes)return EFI_COMPROMISED_DATA;
+    Bytes-=Actual; Data=(UINT8 *)Data+Actual;
+  }
+  return EFI_SUCCESS;
+}
+STATIC EFI_STATUS RestoreStream(EFI_FILE_PROTOCOL *Root, VOID *Destination, UINTN Capacity) {
+  EFI_FILE_PROTOCOL *File=NULL;
+  EFI_STATUS Status;
+  UINT8 Header[32],Extra;
+  UINT8 *Extents=NULL;
+  UINT64 Logical,Count,Offset,Length,End=0;
+  UINTN I,Bytes;
+  Status=Root->Open(Root,&File,L"\\EFI\\UniXNU\\Payloads\\restore.dbrdisk",EFI_FILE_MODE_READ,0);
+  if(EFI_ERROR(Status))return Status;
+  Status=RestoreReadExact(File,Header,sizeof(Header));
+  if(EFI_ERROR(Status))goto Done;
+  Logical=U64(Header+16); Count=U64(Header+24);
+  if(CompareMem(Header,"DBRDISK1",8) || U32(Header+8)!=1 || U32(Header+12)!=4096 ||
+     Logical!=Capacity || !Count || Count>65536) {Status=EFI_COMPROMISED_DATA;goto Done;}
+  Extents=AllocatePool((UINTN)Count*16);
+  if(Extents==NULL){Status=EFI_OUT_OF_RESOURCES;goto Done;}
+  Status=RestoreReadExact(File,Extents,(UINTN)Count*16);
+  if(EFI_ERROR(Status))goto Done;
+  for(I=0;I<Count;++I) {
+    Offset=U64(Extents+16*I); Length=U64(Extents+16*I+8);
+    if(!Length || ((Offset|Length)&4095) || Offset<End || Offset>Logical || Length>Logical-Offset) {
+      Status=EFI_COMPROMISED_DATA;goto Done;
+    }
+    End=Offset+Length;
+  }
+  // The owned window has already been zeroed. Only nonzero extents are read.
+  for(I=0;I<Count;++I) {
+    Offset=U64(Extents+16*I); Length=U64(Extents+16*I+8);
+    Status=RestoreReadExact(File,(UINT8 *)Destination+(UINTN)Offset,(UINTN)Length);
+    if(EFI_ERROR(Status))goto Done;
+  }
+  Bytes=1; Status=File->Read(File,&Bytes,&Extra);
+  if(!EFI_ERROR(Status) && (Bytes || CompareMem((UINT8 *)Destination+32,"NXSB",4)))Status=EFI_COMPROMISED_DATA;
+Done:
+  if(Extents!=NULL)FreePool(Extents);
+  File->Close(File);
+  return Status;
+}
