+// These are the EDK2 LzmaCustomDecompressLib entry points.
+RETURN_STATUS EFIAPI LzmaUefiDecompressGetInfo(CONST VOID *,UINT32,UINT32 *,UINT32 *);
+RETURN_STATUS EFIAPI LzmaUefiDecompress(CONST VOID *,UINTN,VOID *,VOID *);
+STATIC EFI_STATUS ExpandKernel(VOID **Image, UINTN *Size) {
+  UINT32 Expanded,ScratchBytes;
+  VOID *Decoded,*Scratch;
+  RETURN_STATUS Result;
+  if(*Size<21 || CompareMem(*Image,"ERHLZMA1",8))return EFI_UNSUPPORTED;
+  Result=LzmaUefiDecompressGetInfo((UINT8 *)*Image+8,(UINT32)*Size-8,&Expanded,&ScratchBytes);
+  if(RETURN_ERROR(Result) || !Expanded || Expanded>SIZE_128MB || ScratchBytes>SIZE_1MB)return EFI_COMPROMISED_DATA;
+  Decoded=AllocatePool(Expanded); Scratch=AllocatePool(ScratchBytes);
+  if(Decoded==NULL || Scratch==NULL) {
+    if(Decoded!=NULL)FreePool(Decoded);
+    if(Scratch!=NULL)FreePool(Scratch);
+    return EFI_OUT_OF_RESOURCES;
+  }
+  Result=LzmaUefiDecompress((UINT8 *)*Image+8,*Size-8,Decoded,Scratch);
+  FreePool(Scratch);
+  if(RETURN_ERROR(Result) || U32(Decoded)!=0xfeedfacf) {FreePool(Decoded);return EFI_COMPROMISED_DATA;}
+  FreePool(*Image);*Image=Decoded;*Size=Expanded;
+  return EFI_SUCCESS;
 }
 
