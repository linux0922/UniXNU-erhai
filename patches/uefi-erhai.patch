diff --git a/Resources/Configs/erhai.toml b/Resources/Configs/erhai.toml
new file mode 100644
--- /dev/null
+++ b/Resources/Configs/erhai.toml
@@ -0,0 +1,33 @@
+#
+# erhai (OnePlus Pad 2 Pro / OPD2413, SM8750P) — UEFI FD + boot shim config
+# Derived from Resources/Configs/pagani.toml (OnePlus 13T, same SM8750 Sun platform).
+#
+# FD base/size follow the stock uefi_a layout measured on this unit
+# (board.toml: FD base 0xA7000000, size 0x2A8000 from the stock uefi_a ELF PT_LOAD).
+# pagani uses 0xA7100000 / 0x300000 inside the same reserved window
+# (FD_Reserved 0xA7000000 + 0x100000, UEFI_FD 0xA7100000 + 0x300000).
+# Start from the stock layout; switch to 0xA7100000/0x300000 only if the
+# firmware image does not fit or the ABL rejects it.
+#
+[boot_shim]
+requires_kernel_header = true
+
+#
+# UEFI FD Configs
+#
+[uefi_fd]
+base = 0xA7000000
+size = 0x2A8000
+
+#
+# Android Boot Image Kernel Configs
+#
+[boot_image_kernel]
+kernel_compression = "gzip"
+append_dtb         = true
+
+#
+# Android Boot Image Configs
+#
+[boot_image]
+header_version = 4
diff --git a/BootShim/BootShim.S b/BootShim/BootShim.S
--- a/BootShim/BootShim.S
+++ b/BootShim/BootShim.S
@@ -1,3 +1,12 @@
+#if FD_BASE == 0xA7000000 && FD_SIZE == 0x2A8000
+/* erhai: use the upper half of the reserved Kernel region. */
+#define PAYLOAD_DEST 0xA8001000
+#define PAYLOAD_HANDOFF 0xA8000000
+#define PAYLOAD_MAGIC 0x554E49584E555241
+#else
+#define PAYLOAD_DEST (FD_BASE + FD_SIZE)
+#endif
+
 _Head:
   adr   x1, _Payload    /* Set _Entry address */
   b     _Start          /* Jump to the real code */
@@ -6,8 +15,12 @@
 _StackBase:
   .quad FD_BASE         /* Text Offset */
 
+#ifndef EMBEDDED_PAYLOAD_SIZE
+#define EMBEDDED_PAYLOAD_SIZE 0
+#endif
+
 _StackSize:
-  .quad FD_SIZE + (_Payload - _Head) /* Complete shim and payload */
+  .quad FD_SIZE + (_Payload - _Head) + EMBEDDED_PAYLOAD_SIZE /* Complete shim, firmware and payload */
   .quad 0               /* Flags */
   .quad 0               /* Reserved */
   .quad 0               /* Reserved */
@@ -20,7 +33,7 @@
   mov   x4, x1
   ldr   x5, =FD_BASE
   cmp   x4, x5
-  beq   _Entry
+  beq   _CopyPayload
   ldr   x6,  =FD_SIZE
 
 _CopyLoop:
@@ -28,6 +41,100 @@
   stp   x2, x3, [x5], #16
   subs  x6, x6, #16
   b.ne  _CopyLoop
+  ldr   x5, =FD_BASE
+
+_CopyPayload:
+  /* The large payload destination overlaps the ABL's compressed-kernel entry.
+   * Move the entire shim, including its literal pool, into the protected
+   * handoff page before moving the payload. The first 16 bytes remain metadata.
+   */
+  adr   x12, _Payload
+  ldr   x7, =FD_SIZE
+  add   x12, x12, x7
+  adr   x4, _Head
+  ldr   x5, =(PAYLOAD_HANDOFF + 0x800)
+  mov   x13, x5
+  adr   x6, _Payload
+  sub   x6, x6, x4
+_CopyShim:
+  ldp   x2, x3, [x4], #16
+  stp   x2, x3, [x5], #16
+  subs  x6, x6, #16
+  b.ne  _CopyShim
+  dsb   sy
+  mrs   x9, ctr_el0
+  ubfx  x9, x9, #16, #4
+  mov   x10, #4
+  lsl   x9, x10, x9
+  sub   x10, x9, #1
+  bic   x8, x13, x10
+  adr   x7, _Payload
+  adr   x6, _Head
+  sub   x7, x7, x6
+  add   x7, x13, x7
+_CleanShim:
+  dc    cvac, x8
+  add   x8, x8, x9
+  cmp   x8, x7
+  b.lo  _CleanShim
+  dsb   sy
+  ic    iallu
+  dsb   sy
+  isb
+  adr   x14, _PayloadRelocated
+  adr   x7, _Head
+  sub   x14, x14, x7
+  add   x13, x13, x14
+  br    x13
+_PayloadRelocated:
+  /*
+   * OnePlus ABL replaces the ramdisk field, so the payload rides behind the
+   * firmware volume inside the kernel field.  Its load address depends on where
+   * the ABL put the image; move it to FD_BASE + FD_SIZE so the firmware can
+   * publish it from a fixed address.
+   */
+  ldr   x6, =EMBEDDED_PAYLOAD_SIZE
+#ifdef PAYLOAD_HANDOFF
+  cbnz  x6, _HasPayload
+  ldr   x9, =PAYLOAD_HANDOFF
+  stp   xzr, xzr, [x9]
+_HasPayload:
+#endif
+  cbz   x6, _Entry
+  mov   x4, x12                 /* original payload address saved before relocation */
+  ldr   x5, =PAYLOAD_DEST
+  cmp   x5, x4
+  beq   _PayloadDone
+  b.lo  _CopyPayloadForward
+  sub   x7, x5, x4
+  cmp   x7, x6
+  b.hs  _CopyPayloadForward
+  add   x4, x4, x6
+  add   x5, x5, x6
+
+_CopyPayloadBackward:
+  ldrb  w8, [x4, #-1]!
+  strb  w8, [x5, #-1]!
+  subs  x6, x6, #1
+  b.ne  _CopyPayloadBackward
+  b     _PayloadDone
+
+_CopyPayloadForward:
+  mov   x7, x6
+
+_CopyPayloadLoop:
+  ldrb  w8, [x4], #1
+  strb  w8, [x5], #1
+  subs  x7, x7, #1
+  b.ne  _CopyPayloadLoop
+
+_PayloadDone:
+#ifdef PAYLOAD_HANDOFF
+  ldr   x9, =PAYLOAD_HANDOFF
+  ldr   x10, =PAYLOAD_MAGIC
+  ldr   x6, =EMBEDDED_PAYLOAD_SIZE
+  stp   x10, x6, [x9]
+#endif
   ldr   x5, =FD_BASE
 
 _Entry:
