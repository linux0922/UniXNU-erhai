+STATIC
+VOID
+PublishInitrd (
+  IN CONST VOID  *Fdt
+  )
+{
+  INT32       Chosen;
+  CONST VOID  *StartProp;
+  CONST VOID  *EndProp;
+  INT32       StartLength;
+  INT32       EndLength;
+  UINT64      Start;
+  UINT64      End;
+
+  Chosen = FdtPathOffset (Fdt, "/chosen");
+  if (Chosen < 0) {
+    DEBUG ((DEBUG_ERROR, "UNIXNURAMDISK: no /chosen\n"));
+    return;
+  }
+
+  StartProp = FdtGetProp (Fdt, Chosen, "linux,initrd-start", &StartLength);
+  EndProp   = FdtGetProp (Fdt, Chosen, "linux,initrd-end", &EndLength);
+  if ((FdtGetProp (Fdt, Chosen, "unixnu,payload-start", NULL) != NULL) ||
+      (StartProp == NULL) || (EndProp == NULL) ||
+      ((StartLength != 4) && (StartLength != 8)) || ((EndLength != 4) && (EndLength != 8)))
+  {
+    //
+    // erhai / OnePlus: the ABL replaces the ramdisk field on `fastboot boot`,
+    // so the payload rides inside the kernel field right behind the firmware
+    // volume.  The packer records that window in /chosen as
+    // unixnu,payload-start / unixnu,payload-size.
+    //
+    CONST VOID  *SizeProp;
+    INT32       SizeLength;
+    UINT64      PayloadStart;
+    UINT64      PayloadSize;
+
+    StartProp = FdtGetProp (Fdt, Chosen, "unixnu,payload-start", &StartLength);
+    SizeProp  = FdtGetProp (Fdt, Chosen, "unixnu,payload-size", &SizeLength);
+    if ((StartProp == NULL) || (SizeProp == NULL) ||
+        ((StartLength != 4) && (StartLength != 8)) || ((SizeLength != 4) && (SizeLength != 8)))
+    {
+      DEBUG ((DEBUG_ERROR, "UNIXNURAMDISK: no initrd and no embedded payload in /chosen\n"));
+      return;
+    }
+
+    PayloadStart = ReadCells (StartProp, StartLength / 4);
+    PayloadSize  = ReadCells (SizeProp, SizeLength / 4);
+    if (PayloadSize == 0) {
+      DEBUG ((DEBUG_ERROR, "UNIXNURAMDISK: embedded payload size is zero\n"));
+      return;
+    }
+
+    DEBUG ((DEBUG_ERROR, "UNIXNURAMDISK: embedded payload 0x%lx size 0x%lx\n", PayloadStart, PayloadSize));
+    Start = PayloadStart;
+    End   = PayloadStart + PayloadSize;
+  }
+  else
+  {
+    Start = ReadCells (StartProp, StartLength / 4);
+    End   = ReadCells (EndProp, EndLength / 4);
+  }
+  PublishRamDisk (Start, End);
 }
 
